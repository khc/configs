command = /opt/homebrew/bin/fish
font-family = "Source Code Pro"
font-size = 14
font-thicken = true
background = 101020
foreground = f5f7fa
background-opacity = 0.9858066633
cursor-color = bbbbbb
cursor-text = ffffff
selection-background = b5d5ff
selection-foreground = 000000
bold-color = f5f7fa
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,no-title
window-width = 222
window-height = 66
window-padding-x = 10
window-padding-y = 10
window-padding-color = background
palette = 0=#000000
palette = 1=#ed5565
palette = 2=#8cc152
palette = 3=#ffce54
palette = 4=#62a5f9
palette = 5=#d770ad
palette = 6=#3bafda
palette = 7=#bbbbbb
palette = 8=#555555
palette = 9=#fc6e51
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5d9cec
palette = 13=#ec87c0
palette = 14=#4fc1e9
palette = 15=#ffffff
