// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git_panel": {
    "tree_view": true,
    "button": true,
    "dock": "left"
  },
  "project_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "commit_message_instructions": "Generate a Git commit message from the provided diff.\n\n- Follow Conventional Commits 1.0.0 exactly: `<type>[(scope)][!]: <description>`, with the scope in parentheses, e.g. `fix(parser): handle empty input`.\n- Use only these commit types: feat, fix, refactor, perf, docs, test, build, ci, chore, style.\n- Choose the type that best represents the overall purpose of the change. Use `feat` whenever the change adds functionality and `fix` whenever it corrects a bug; use another type only when neither applies.\n- If the diff spans multiple unrelated changes, choose the type and scope of the primary or highest-impact change; do not invent a combined or generic type to cover everything.\n- Use `style` exclusively for formatting or whitespace changes that do not affect behavior. Use `refactor` for structural changes that preserve behavior.\n- Add a scope only when it can be inferred confidently from the changed code. The scope must be a concise noun describing the affected part of the codebase. Avoid generic scopes such as `core`, `misc`, or `general` unless they are actual module names.\n- Use the current branch name when it is provided or you can obtain it with `git branch --show-current`. If it contains a work item id (the first case-sensitive match of `[A-Z][A-Z0-9]+-[0-9]+`, e.g. `JIRA-123` in `feat/JIRA-123-add-some-feature`), start the description with that id followed by a space, e.g. `feat(module): JIRA-123 add some feature`. Do not use other id forms such as `#123` or lowercase keys. Take only the id from the branch name; derive the rest of the description from the diff. If the branch name is unavailable or has no id, omit the id; do not invent one.\n- Use lowercase for the type, scope, and first letter of the description, except for work item ids, proper nouns, or acronyms.\n- Start the description (after the work item id, when present) with a lowercase imperative verb (e.g., add, fix, remove, update, simplify, extract). Describe what the commit accomplishes, not what was done.\n- Do not end the subject line with a period.\n- Keep the subject line, including type, scope, and work item id, at most 71 characters.\n- Focus on the intent and overall purpose of the change, not low-level implementation details.\n- Mark a change as breaking when the diff incompatibly changes a public API, config, CLI, or data contract. For breaking changes, add `!` immediately before the colon; when no footer is used, make the description state the break. Include a `BREAKING CHANGE: <description>` footer when the compatibility impact or required migration steps need explanation. Separate the footer from the subject or body with exactly one blank line.\n- Always include a body (the commit description) after the subject, in addition to the subject line.\n- Leave exactly one blank line after the subject and write 3 to 5 concise bullet points, each wrapped at roughly 72 characters.\n- In the body, describe why the change was made or important behavioral consequences, not a file-by-file summary. Each bullet must be supported by the diff.\n- Do not invent information that cannot be inferred from the diff or the branch name.\n- Output exactly one commit message.\n- Output only the commit message. Output plain text only (no headings, code fences, emphasis, labels, alternatives, explanations, or commentary); `- ` bullets in the body are allowed.",
    "commit_message_include_project_rules": false
  },
  "cli_default_open_behavior": "new_window",
  "icon_theme": {
    "mode": "light",
    "light": "Bearded Icon Theme",
    "dark": "Zed (Default)",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
      },
      "type": "registry",
    },
  },
  "base_keymap": "VSCode",
  "ui_font_size": 15,
  "ui_font_family": ".SystemUIFont",
  "agent_ui_font_size": 15,
  "agent_ui_font_family": ".SystemUIFont",
  "agent_buffer_font_size": 13,
  "agent_buffer_font_family": ".SystemUIFont",
  "buffer_font_size": 14,
  "buffer_font_family": "Source Code Pro",
  "theme": {
    "mode": "light",
    "light": "Bearded Theme Light",
    "dark": "One Dark",
  }
}
